#!/bin/bash

# Pre-commit hook para bloquear commits com secrets
# Usa expressões regulares para detectar padrões perigosos

set -e

# Cores
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

# Padrões de secrets a bloquear
PATTERNS=(
    "ENCRYPTION_KEY="
    "DATABASE_URL="
    "SUPABASE.*KEY="
    "SUPABASE.*SECRET="
    "PRIVATE_KEY="
    "API_SECRET="
    "JWT_SECRET="
    "SESSION_SECRET="
    "postgres://"
    "postgresql://"
)

echo -e "${YELLOW}🔍 Verificando secrets no commit...${NC}"

# Obter arquivos staged
FILES=$(git diff --cached --name-only --diff-filter=ACM)

FOUND_SECRETS=0

for FILE in $FILES; do
    # Pular .env.example e documentação
    if [[ "$FILE" == ".env.example" ]] || [[ "$FILE" == "ENCRYPTION_KEY.md" ]] || [[ "$FILE" == "*.md" ]]; then
        continue
    fi

    for PATTERN in "${PATTERNS[@]}"; do
        if git diff --cached "$FILE" | grep -iE "$PATTERN" > /dev/null; then
            echo -e "${RED}❌ BLOQUEADO: Possível secret encontrado em '$FILE'${NC}"
            echo -e "${RED}   Padrão: $PATTERN${NC}"
            FOUND_SECRETS=1
        fi
    done
done

if [ $FOUND_SECRETS -eq 1 ]; then
    echo ""
    echo -e "${RED}🚫 COMMIT BLOQUEADO - Secrets detectados!${NC}"
    echo ""
    echo "Causas comuns:"
    echo "  1. Você commitou .env com credenciais"
    echo "  2. Você commitou variáveis de ambiente"
    echo ""
    echo "Solução:"
    echo "  1. Retirar o arquivo da staging area: git reset HEAD <arquivo>"
    echo "  2. Adicionar à .gitignore se necessário"
    echo "  3. Usar Vercel/Supabase para gerenciar secrets"
    echo ""
    exit 1
fi

echo -e "${GREEN}✅ Nenhum secret detectado. Commit permitido.${NC}"
exit 0
